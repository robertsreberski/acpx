{
  "name": "acpx-console",
  "version": "0.1.0",
  "description": "Local web console for ACPX coding sessions",
  "license": "MIT",
  "author": "OpenClaw Team <dev@openclaw.ai>",
  "repository": {
    "type": "git",
    "url": "https://github.com/robertsreberski/acpx",
    "directory": "packages/console"
  },
  "bin": {
    "acpx-console": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run build:server && pnpm run build:web",
    "build:server": "tsdown src/cli.ts src/index.ts --format esm --dts --clean --platform node --target node22 --no-fixedExtension",
    "build:web": "vite build --config web/vite.config.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run notice:check && pnpm run build && pnpm run test",
    "dev:web": "vite --config web/vite.config.ts",
    "lint": "oxlint --type-aware --deny-warnings src test web/src web/test",
    "notice:check": "node ../../scripts/console-third-party-notices.mjs --check",
    "notice:generate": "node ../../scripts/console-third-party-notices.mjs --write",
    "prepack": "pnpm run notice:check && pnpm run build",
    "test": "tsx --test test/*.test.ts web/test/*.test.ts",
    "typecheck": "tsc --noEmit && pnpm run typecheck:web",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.14",
    "@assistant-ui/react-markdown": "0.14.10",
    "@fontsource-variable/inter": "5.3.0",
    "acpx": "0.13.0-fork.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.34.5"
}
